<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- 1. Multi-Company Record Rule:
         - For strictly company-dependent models: [('company_id', 'in', company_ids)]
         - For optionally shared models (e.g. contacts, products): ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
    -->
    <record id="rule_custom_item_multi_company" model="ir.rule">
        <field name="name">Custom Item: Multi-Company Isolation</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- 2. Personal Records Rule: Users only access items assigned to them -->
    <record id="rule_custom_item_personal" model="ir.rule">
        <field name="name">Custom Item: Personal Records</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="domain_force">['|', ('partner_id.user_ids', 'in', [user.id]), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_custom_item_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 3. Manager Rule: Managers see all records across the company -->
    <record id="rule_custom_item_manager_all" model="ir.rule">
        <field name="name">Custom Item: Manager Access All</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_custom_item_manager'))]"/>
    </record>

</odoo>
