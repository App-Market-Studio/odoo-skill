<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Scheduled Action / Cron -->
    <record id="ir_cron_custom_item_daily_process" model="ir.cron">
        <field name="name">Custom Module: Daily Item Processor</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily_process()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
