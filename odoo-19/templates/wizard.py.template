# -*- coding: utf-8 -*-

from odoo import Command, _, api, fields, models
from odoo.exceptions import UserError


class CustomItemBatch(models.TransientModel):
    """
    Transient Model (Wizard) following official Odoo naming:
    - Avoid the 'wizard' word in _name.
    - Pattern: <related_base_model>.<action> (e.g. 'custom.item.batch', 'account.invoice.make').
    - File naming: wizard/<transient>.py and wizard/<transient>_views.xml.
    """
    _name = 'custom.item.batch'
    _description = 'Batch Item Processing'

    # Retrieve selected records from active context
    target_ids = fields.Many2many(
        'custom.item',
        string='Selected Items',
        default=lambda self: self.env.context.get('active_ids'),
        required=True,
    )
    action_type = fields.Selection(
        selection=[
            ('confirm', 'Confirm All'),
            ('done', 'Mark as Done'),
            ('cancel', 'Cancel All'),
        ],
        string='Action',
        default='confirm',
        required=True,
    )
    notes = fields.Text(string='Processing Notes')

    def action_apply(self):
        """Execute the batch operation and close the wizard modal."""
        self.ensure_one()
        if not self.target_ids:
            raise UserError(_("Please select at least one record to process."))

        if self.action_type == 'confirm':
            for record in self.target_ids:
                if record.state == 'draft':
                    record.action_confirm()
        elif self.action_type == 'done':
            self.target_ids.action_done()
        elif self.action_type == 'cancel':
            self.target_ids.action_cancel()

        if self.notes:
            for record in self.target_ids:
                record.message_post(body=_("Batch processed: %(notes)s", notes=self.notes))

        # Close the modal window in the webclient
        return {'type': 'ir.actions.act_window_close'}
