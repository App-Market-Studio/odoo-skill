<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        SECURITY GROUP GUARDRAIL:
        - Only create new groups if your module requires distinct role-based permissions
          (e.g., standard user vs administrator).
        - If the model is an extension to existing apps (e.g. Sale, Stock, CRM),
          prefer extending their existing groups (e.g., `sales_team.group_sale_salesman`)
          rather than creating redundant parallel security hierarchies.
    -->
    <!-- Module Security Category -->
    <record id="module_category_custom_item" model="ir.module.category">
        <field name="name">Custom Module</field>
        <field name="description">Manage access levels for custom items.</field>
        <field name="sequence">30</field>
    </record>

    <!-- Standard User Group -->
    <record id="group_custom_item_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_custom_item"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager Group (Implies User Group + Assigns Admins) -->
    <record id="group_custom_item_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_custom_item"/>
        <field name="implied_ids" eval="[(4, ref('group_custom_item_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
