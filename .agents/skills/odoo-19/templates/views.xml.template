<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST VIEW (<list>) ==================== -->
    <record id="custom_item_view_list" model="ir.ui.view">
        <field name="name">custom.item.view.list</field>
        <field name="model">custom.item</field>
        <field name="arch" type="xml">
            <list string="Custom Items"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'"
                  sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="total_amount" sum="Grand Total"/>
                <field name="date_deadline" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="custom_item_view_form" model="ir.ui.view">
        <field name="name">custom.item.view.form</field>
        <field name="model">custom.item</field>
        <field name="arch" type="xml">
            <form string="Custom Item">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done"
                            type="object"
                            string="Mark as Done"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <!-- Button Box with Stat Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list">
                            <field name="line_ids" widget="statinfo" string="Lines"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'done'"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Item Title..."/>
                        </h1>
                    </div>

                    <group>
                        <group name="partner_details">
                            <field name="partner_id" readonly="state in ('done', 'cancel')"/>
                            <field name="date_deadline" readonly="state == 'done'"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group name="financial_details">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state in ('done', 'cancel')"/>
                            <field name="tax_percent" readonly="state in ('done', 'cancel')"/>
                            <field name="total_amount"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Line Details" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total Lines"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Odoo Chatter Component -->
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="custom_item_view_search" model="ir.ui.view">
        <field name="name">custom.item.view.search</field>
        <field name="model">custom.item</field>
        <field name="arch" type="xml">
            <search string="Search Items">
                <field name="name" string="Item / Description"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== WINDOW ACTION ==================== -->
    <record id="custom_item_action" model="ir.actions.act_window">
        <field name="name">Custom Items</field>
        <field name="res_model">custom.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="custom_item_view_search"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first custom item!
            </p>
        </field>
    </record>

    <!-- ==================== MENUS ==================== -->
    <menuitem id="custom_item_menu_root"
              name="Custom App"
              sequence="50"/>

    <menuitem id="custom_item_menu_action"
              name="Items"
              parent="custom_item_menu_root"
              action="custom_item_action"
              sequence="10"/>

    <!-- ==================== INHERITING VIEW PATTERN ==================== -->
    <!--
        Best Practices for Inheriting Views:
        1. Unique XML ID: Assign a unique, descriptive XML ID for each new inherited view record,
           conventionally: <target_view_id>_inherit_<module_or_feature>
           (e.g., 'view_partner_form_inherit_custom_item').
           Note: Reusing the target ID (e.g. id="view_partner_form") in another module creates a
           module-qualified external ID (my_module.view_partner_form). While seen in core shorthand,
           giving each view a distinct ID avoids collisions when multiple views in the same module
           inherit the same base view. Reusing the base ID is primarily appropriate when intentionally
           updating that exact existing record in-place via an XML data update.
        2. View name: Append '.inherit.<details>' to indicate extension (e.g., 'res.partner.view.form.inherit.custom.item').
        3. Primary inheritance: Use <field name="mode">primary</field> only when creating a distinct new view branch.
    -->
