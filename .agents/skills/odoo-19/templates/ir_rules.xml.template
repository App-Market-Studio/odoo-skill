<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- =========================================================================
         REFERENCE SCAFFOLD: RECORD RULES (OPTIONAL PATTERNS)
         =========================================================================
         WARNING: DO NOT BLINDLY COPY THIS ENTIRE FILE.
         Record rules are additive SQL WHERE clauses evaluated on EVERY query.
         - For most models, model-level security in 'ir.model.access.csv' is sufficient.
         - ONLY create a record rule when explicit data partitioning is required.
         - If neither multi-company nor row-level user partitioning is needed,
           DO NOT create a security XML file.
         ========================================================================= -->

    <!--
    PATTERN 1: Multi-Company Isolation
    PREREQUISITE: Model MUST have a 'company_id' field.
    Omit this rule if the model has no company_id (e.g. system configs, global tags).
    
    <record id="custom_item_rule_company" model="ir.rule">
        <field name="name">Custom Item: Multi-Company Isolation</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    -->

    <!--
    PATTERN 2: Personal Records (Row-Level User Partitioning)
    PREREQUISITE: Business requirements explicitly demand that standard users
    only access records they created or are assigned to.
    
    <record id="custom_item_rule_user" model="ir.rule">
        <field name="name">Custom Item: Personal Records</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="domain_force">['|', ('partner_id.user_ids', 'in', [user.id]), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('custom_item_group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    -->

    <!--
    PATTERN 3: Manager Full-Access Override
    PREREQUISITE: Used in combination with Pattern 2 so managers can access all records.
    
    <record id="custom_item_rule_manager" model="ir.rule">
        <field name="name">Custom Item: Manager Access All</field>
        <field name="model_id" ref="model_custom_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_item_group_manager'))]"/>
    </record>
    -->

</odoo>
