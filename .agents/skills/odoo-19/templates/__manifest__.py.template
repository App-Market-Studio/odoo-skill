# -*- coding: utf-8 -*-
{
    'name': 'My Odoo 19 Module',
    'version': '19.0.1.0.0',
    'category': 'Customizations',
    'summary': 'Modern, portable Odoo 19 module template',
    'description': """
        Odoo 19.0 Production Module Template:
        - Modern ORM models with SQL Table Objects (models.Constraint, models.UniqueIndex)
        - Clean <list> and <form> views with Python expression modifiers and <chatter/>
        - Native OWL 2 components and registries
        - Strict security loading order and multi-company support
        - Official Odoo file structure and naming conventions
    """,
    'author': 'Your Name or Company',
    'website': 'https://www.example.com',
    'license': 'LGPL-3',
    'depends': [
        'base',
        'web',
        'mail',
    ],
    # STRICT DATA ORDER according to official guidelines:
    # 1. Security Groups (<module>_groups.xml)
    # 2. Model ACLs (ir.model.access.csv)
    # 3. Record Rules (<model>_security.xml)
    # 4. Sequenced / Business Data (data/<model>_data.xml)
    # 5. Backend Views (<model>_views.xml)
    # 6. Report Actions & Templates (report/<model>_reports.xml, report/<model>_templates.xml)
    # 7. Menus LAST (views/<module>_menus.xml)
    'data': [
        'security/my_module_groups.xml',       # 1. Custom Security Groups FIRST
        'security/ir.model.access.csv',         # 2. Model Access Control Lists
        'security/my_model_security.xml',       # 3. Record Rules (<model>_security.xml)
        'data/ir_sequence_data.xml',            # 4. Number Sequences (noupdate="1")
        'data/ir_cron_data.xml',                # 5. Scheduled Actions (noupdate="1")
        'data/my_model_data.xml',               # 6. Initial Master Data
        'views/my_model_views.xml',             # 7. Form, List, Search Views
        'report/my_model_reports.xml',          # 8. QWeb PDF Report Actions
        'report/my_model_templates.xml',        # 9. QWeb Report Templates
        'views/my_module_menus.xml',            # 10. Menu Items LAST
    ],
    # Demo data placed under data/ suffixed by _demo.xml (never a demo/ folder)
    'demo': [
        'data/my_model_demo.xml',
    ],
    'assets': {
        'web.assets_backend': [
            'my_module/static/src/js/**/*.js',
            'my_module/static/src/xml/**/*.xml',
            'my_module/static/src/scss/**/*.scss',
        ],
        'web.assets_unit_tests': [
            'my_module/static/tests/**/*.test.js',
        ],
    },
    # Odoo 19 Hook: accepts a single 'env' parameter
    'post_init_hook': '_post_init_hook',
    'installable': True,
    'application': True,
    'auto_install': False,
}
