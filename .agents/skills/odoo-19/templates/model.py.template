# -*- coding: utf-8 -*-

# 1 : external libraries (sorted)
# 2 : odoo imports (ASCIIbetically ordered)
from odoo import Command, _, api, fields, models
from odoo.exceptions import UserError, ValidationError
from odoo.tools import SQL


class CustomItem(models.Model):
    """
    Standard Odoo 19 Model Structure following the official 10-section attribute ordering:
      1. Private attributes
      2. Default methods and default_get
      3. Field declarations
      4. SQL constraints and indexes (SQL Table Objects)
      5. Compute, inverse and search methods (in same order as field declarations)
      6. Selection methods
      7. Constrains (@api.constrains) and onchange (@api.onchange) methods
      8. CRUD methods (create, write, unlink overrides)
      9. Action methods (action_*, self.ensure_one())
      10. Business methods & private helpers
    """

    # 1. Private attributes
    _name = 'custom.item'
    _description = 'Custom Item'
    _inherit = ['mail.thread', 'mail.activity.mixin']
    _order = 'sequence, id desc'
    _rec_name = 'name'
    _check_company_auto = True

    # 2. Default methods and default_get
    def _default_date_deadline(self):
        return fields.Date.context_today(self)

    # 3. Fields declaration
    name = fields.Char(
        string='Title',
        required=True,
        tracking=True,
        translate=True,
        index=True,
    )
    code = fields.Char(string='Reference Code', copy=False)
    sequence = fields.Integer(string='Sequence', default=10)
    active = fields.Boolean(string='Active', default=True)

    state = fields.Selection(
        selection='_selection_state',
        string='Status',
        default='draft',
        required=True,
        tracking=True,
        copy=False,
        index=True,
    )

    # --- Multi-Company & Relational Consistency ---
    # Apply the Multi-Company Decision Matrix:
    # 1. Company-dependent models: company_id required, strict record rules
    # 2. Optionally shared models (e.g. res.partner, product.template): company_id nullable
    # 3. Global models: no company_id
    # check_company=True belongs on relations requiring consistency (e.g. account, journal, warehouse)
    partner_id = fields.Many2one(
        'res.partner',
        string='Partner',
        ondelete='restrict',
        tracking=True,
    )
    company_id = fields.Many2one(
        'res.company',
        string='Company',
        default=lambda self: self.env.company,
        required=True,
    )
    currency_id = fields.Many2one(
        'res.currency',
        related='company_id.currency_id',
        string='Currency',
    )

    amount = fields.Monetary(string='Amount', currency_field='currency_id', aggregator='sum')
    tax_percent = fields.Float(string='Tax (%)', default=15.0)
    # Note: On parent header records, omit precompute=True to avoid bypassing ORM
    # prefetching during single-record inserts. Use precompute=True on child lines instead.
    total_amount = fields.Monetary(
        string='Total Amount',
        compute='_compute_total_amount',
        store=True,
        currency_field='currency_id',
        aggregator='sum',
    )

    date_deadline = fields.Date(string='Deadline', default=_default_date_deadline)
    tag_ids = fields.Many2many('custom.tag', string='Tags')
    line_ids = fields.One2many('custom.item.line', 'item_id', string='Lines', copy=True)
    metadata = fields.Json(string='Extra Data')

    # 4. SQL constraints and indexes (SQL Table Objects - Name MUST begin with '_')
    _positive_amount = models.Constraint(
        "CHECK(amount >= 0)",
        "Amount cannot be negative.",
    )

    _unique_code = models.UniqueIndex(
        "(code) WHERE code IS NOT NULL",
        "Reference code must be unique.",
    )

    # 5. Compute, inverse and search methods (in same order as field declarations)
    @api.depends('amount', 'tax_percent')
    def _compute_total_amount(self):
        for record in self:
            tax = (record.amount * record.tax_percent) / 100.0
            record.total_amount = record.amount + tax

    # 6. Selection methods
    @api.model
    def _selection_state(self):
        return [
            ('draft', 'Draft'),
            ('confirmed', 'Confirmed'),
            ('done', 'Done'),
            ('cancel', 'Cancelled'),
        ]

    # 7. Constrains and onchange methods
    @api.constrains('date_deadline')
    def _check_deadline(self):
        for record in self:
            if record.date_deadline and record.create_date:
                if record.date_deadline < record.create_date.date():
                    raise ValidationError(_("Deadline cannot be prior to creation date."))

    @api.onchange('partner_id')
    def _onchange_partner_id(self):
        if self.partner_id and not self.code:
            self.code = self.partner_id.ref or False

    # 8. CRUD methods (ORM overrides)
    @api.model_create_multi
    def create(self, vals_list):
        for vals in vals_list:
            if not vals.get('name') or vals.get('name') == _('New'):
                vals['name'] = self.env['ir.sequence'].next_by_code('custom.item') or _('New')
        return super().create(vals_list)

    @api.ondelete(at_uninstall=False)
    def _unlink_except_confirmed(self):
        if any(rec.state not in ('draft', 'cancel') for rec in self):
            raise UserError(_("Cannot delete confirmed or completed items."))

    # 9. Action methods (prefixed with action_*)
    # Contract semantics:
    # - Single-record actions (e.g. form buttons): Enforce self.ensure_one()
    # - Multi-record actions (e.g. list view / batch server actions): Preserve recordset semantics (no ensure_one)
    def action_confirm(self):
        """Single-record action: transitions state to confirmed."""
        self.ensure_one()
        if self.state != 'draft':
            raise UserError(_("Only draft items can be confirmed."))
        self.state = 'confirmed'
        self.message_post(body=_("Item %(name)s has been confirmed.", name=self.display_name))

    def action_cancel(self):
        """Batch-capable action: cancels all items in the current recordset."""
        for item in self:
            if item.state == 'done':
                raise UserError(_("Completed item %(name)s cannot be canceled.", name=item.display_name))
        self.write({'state': 'cancel'})

    # 10. Business methods & private helpers
    @api.private
    def _fetch_partner_summary(self, partner_id):
        """Fetch aggregated partner summary using native ORM.
        
        Native _read_group() is preferred by default because it:
        - Automatically enforces Odoo record rules (ir.rule) and access rights.
        - Stays synchronized with in-memory transaction cache.
        - Preserves multi-company security domains.
        """
        domain = [
            ('partner_id', '=', partner_id),
            ('company_id', '=', self.env.company.id),
        ]
        data = self.env['custom.item']._read_group(
            domain=domain,
            groupby=[],
            aggregates=['__count', 'amount:sum'],
        )
        if data:
            total_items, total_val = data[0]
            return {'total_items': total_items, 'total_val': total_val or 0.0}
        return {'total_items': 0, 'total_val': 0.0}

    # -------------------------------------------------------------------------
    # Educational Reference: When is Raw SQL Justified?
    # -------------------------------------------------------------------------
    # Only use raw SQL (self.env.cr.execute with odoo.tools.SQL) when the ORM is
    # measurably inadequate (e.g. massive bulk operations, complex analytical CTEs).
    #
    # When using raw SQL, you MUST:
    # 1. Flush dirty ORM cache first: self.env['custom.item'].flush_model(['amount', 'state'])
    # 2. Parameterize safely: SQL("SELECT ... WHERE partner_id = %s", partner_id)
    # 3. Explicitly enforce multi-company security (company_id = %s)
    # 4. Acknowledge that raw SQL BYPASSES record rules (ir.rule) and field-level security!
    # -------------------------------------------------------------------------


class CustomItemLine(models.Model):
    # 1. Private attributes
    _name = 'custom.item.line'
    _description = 'Custom Item Line'

    # 3. Fields declaration
    item_id = fields.Many2one('custom.item', string='Item', ondelete='cascade', required=True)
    description = fields.Char(string='Description', required=True)
    quantity = fields.Float(string='Quantity', default=1.0)
    price_unit = fields.Float(string='Unit Price', default=0.0)
    subtotal = fields.Float(
        string='Subtotal',
        compute='_compute_subtotal',
        store=True,
        precompute=True,
    )

    # 5. Compute methods
    @api.depends('quantity', 'price_unit')
    def _compute_subtotal(self):
        for line in self:
            line.subtotal = line.quantity * line.price_unit
